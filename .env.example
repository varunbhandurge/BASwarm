# ==============================================================================
# BA ACCOUNT SWARM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Gemini LLM Configuration (Default Provider via OpenAI-Compatible Endpoint)
# Get your free API key from Google AI Studio: https://aistudio.google.com
# Accepts GEMINI_API_KEY, GeminiAPIKey, GOOGLE_API_KEY, or LLM_API_KEY
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Primary model for reasoning, commercial planning, doc architecture (dynamic auto-discovery defaults to gemini-3.8-flash)
LLM_MODEL=gemini-3.8-flash
# Fast model for rapid parallel section generation (BRD/PRD/PDD) and native audio transcription
FAST_LLM_MODEL=gemini-3.8-flash
# Fallback / generic alternative key variable name (if not using GEMINI_API_KEY)
LLM_API_KEY=AIzaSy...your_gemini_api_key_here

# Core Swarm Authentication
# Used to authenticate incoming webhooks and internal dashboard API actions
SWARM_API_KEY=your_swarm_api_key_here
# Optional secret for Vercel Cron verification (Bearer token in Authorization header)
CRON_SECRET=your_vercel_cron_secret_here

# Supabase (Postgres State & HITL Approvals via PostgREST)
SUPABASE_URL=https://your-project-id.supabase.co
# Requires service_role key for backend bypass of RLS
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Meta WhatsApp Cloud API Integration
WHATSAPP_TOKEN=EAAG...your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Zoho CRM Integration (OAuth 2.0 with Refresh Token)
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Domain suffix: zoho.com (US), zoho.eu (EU), zoho.in (IN), zoho.com.au (AU)
ZOHO_API_DOMAIN=zoho.com

# Atlassian Jira REST API v3 Integration
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=engineering-leads@yourcompany.com
JIRA_API_TOKEN=your_jira_api_token_here

# Email & Calendar Integration (Dual Provider: Google Workspace / Microsoft 365)
# Google Gmail & Google Calendar Access Token
GMAIL_ACCESS_TOKEN=ya29.a0AfH6SM...
# Microsoft Graph Access Token (Mail.ReadWrite, Mail.Send, Calendars.ReadWrite)
MS_GRAPH_ACCESS_TOKEN=EwB4A8l6BAAU...
